{
  "name": "converter",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "debug": "tsx watch --inspect src/index.ts",
    "debugr": "tsx --report-on-fatalerror --inspect=0.0.0.0:9229 src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "NODE_ENV=TEST tsx --test --experimental-test-module-mocks --disable-warning='ExperimentalWarning' 'src/**/*.test.ts'",
    "test-cov": "NODE_ENV=TEST tsx --test --experimental-test-coverage --experimental-test-module-mocks --disable-warning='ExperimentalWarning' 'src/**/*.test.ts'"
  },
  "dependencies": {
    "bullmq": "5.79.1",
    "fastify": "5.9.0",
    "node-av": "6.1.1",
    "tsx": "4.22.4",
    "undici": "8.6.0"
  },
  "devDependencies": {
    "@types/node": "25.9.3",
    "pino-pretty": "13.1.3",
    "typescript": "6.0.3"
  }
}
