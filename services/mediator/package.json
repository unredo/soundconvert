{
  "name": "mediator",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "debug": "tsx watch --inspect=0.0.0.0:9229 src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "NODE_ENV=TEST tsx --test --experimental-test-module-mocks --disable-warning='ExperimentalWarning' 'src/**/*.test.ts'",
    "test-only": "NODE_ENV=TEST tsx --test --test-only --experimental-test-module-mocks --disable-warning='ExperimentalWarning' 'src/**/*.test.ts'",
    "test-cov": "NODE_ENV=TEST tsx --test --experimental-test-coverage --experimental-test-module-mocks --disable-warning='ExperimentalWarning' 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@fastify/multipart": "10.0.0",
    "archiver": "8.0.0",
    "bullmq": "5.79.1",
    "fastify": "5.9.0",
    "nanoid": "3.3.15",
    "tsx": "4.22.4"
  },
  "devDependencies": {
    "@types/archiver": "8.0.0",
    "@types/node": "25.9.3",
    "memfs": "4.64.0",
    "pino-pretty": "13.1.3",
    "typescript": "6.0.3"
  }
}
