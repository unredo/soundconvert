{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Run current",
      "runtimeExecutable": "tsx",
      "cwd": "${workspaceFolder}",
      "args": ["--test", "--experimental-test-module-mocks", "--inspect", "${file}"]
    },
    {
      "type": "node-terminal",
      "name": "Debug mediator",
      "request": "launch",
      "command": "npm run -w services/mediator/ debug",
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "node-terminal",
      "name": "Debug converter",
      "request": "launch",
      "command": "npm run -w services/converter/ debug",
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "node-terminal",
      "name": "Debug FE tests",
      "request": "launch",
      "command": "npm run -w services/frontend/ test-dbg",
      "cwd": "${workspaceFolder}"
    }
  ]
}
